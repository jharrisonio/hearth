# Local API (pnpm dev). docker compose sets these itself.
DATABASE_URL=postgres://hearth:hearth@127.0.0.1:54329/hearth
SESSION_SECRET=dev-session-secret-change-me
DEV_AUTH=1
SEED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser origin of the web app. Consent and Google sign-in live here.
PUBLIC_URL=http://127.0.0.1:43123
# Public origin of the API. MCP and OAuth discovery use it. Defaults to
# http://127.0.0.1:$PORT, or https://$RAILWAY_PUBLIC_DOMAIN on Railway.
# OAUTH_ISSUER=http://127.0.0.1:43124
PORT=43124

# Railway only. Leave unset locally.
# WEB_PUBLIC_DOMAIN=
# CORS_ORIGINS=
# DATABASE_SSL=
# API_UPSTREAM=http://api:3001
# API_HOST=
# API_PORT=
