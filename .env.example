# Local API (pnpm dev). docker compose sets these itself.
DATABASE_URL=postgres://hearth:hearth@127.0.0.1:54329/hearth
SESSION_SECRET=dev-session-secret-change-me
DEV_AUTH=1
SEED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser origin of the web app. Must match the Google OAuth redirect host.
PUBLIC_URL=http://127.0.0.1:43123
PORT=43124

# Railway only. Leave unset locally.
# WEB_PUBLIC_DOMAIN=
# CORS_ORIGINS=
# DATABASE_SSL=
# API_UPSTREAM=http://api:3001
# API_HOST=
# API_PORT=
