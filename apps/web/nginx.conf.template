server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # A literal proxy_pass hostname is resolved once, when nginx starts, and that
  # IP is kept for the life of the process. Railway gives the API a new private
  # address on redeploy, and the web service then times out until it restarts.
  # The host below is a variable, so nginx asks the resolver on each request
  # (cached for at most a second) instead of pinning the old address.
  resolver ${NGINX_RESOLVER} valid=1s ipv6=on;
  resolver_timeout 5s;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    set $hearth_api_host "${API_HOST}";
    set $hearth_api_port "${API_PORT}";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass ${API_SCHEME}://$hearth_api_host:$hearth_api_port;
    proxy_http_version 1.1;
    # Task SSE is a long response of small chunks. Buffering holds them until
    # the buffer fills or the upstream closes. Railway's edge drops an HTTP
    # request after 5 idle minutes, and after 15 minutes even with traffic.
    # The API writes a keepalive well inside 60s (nginx's default read
    # timeout) and closes the stream before 15 minutes. 900s is that cap,
    # measured between chunks, not for the whole response.
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  # MCP clients probe this origin for OAuth metadata, including a path suffix
  # (/.well-known/oauth-authorization-server/api,
  # /.well-known/oauth-protected-resource/api/mcp). The API serves those
  # documents at /.well-known/<name>. envsubst only replaces variables that
  # are set in the environment, so the nginx capture in $1 stays, same as
  # the /api/ rewrite.
  location ~ ^/\.well-known/(oauth-authorization-server|oauth-protected-resource) {
    set $hearth_api_host "${API_HOST}";
    set $hearth_api_port "${API_PORT}";
    rewrite ^/\.well-known/(oauth-authorization-server|oauth-protected-resource)(?:/.*)?$ /.well-known/$1 break;
    proxy_pass ${API_SCHEME}://$hearth_api_host:$hearth_api_port;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  # Deep links (/tasks, /t/:key, /projects/:id, /archive, /settings) have no
  # file on disk. Fall back to the app so refresh and a pasted URL both load.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
