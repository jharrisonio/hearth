{
  "name": "hearth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hearth — a household todo list for people and bots.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hearth/api --filter @hearth/web dev",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "isolation-check": "tsx scripts/isolation-check.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "railway": "3.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
